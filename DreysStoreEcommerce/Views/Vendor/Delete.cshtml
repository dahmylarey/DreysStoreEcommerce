@model DreysStoreEcommerce.Models.Product

@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-danger">Delete Product</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete <strong>@Model.Name</strong>?
    </div>

    <form asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="MyProducts" class="btn btn-secondary">Cancel</a>
    </form>
</div>
