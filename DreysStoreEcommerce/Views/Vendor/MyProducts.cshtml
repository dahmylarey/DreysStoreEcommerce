@model IEnumerable<DreysStoreEcommerce.Models.Product>

@{
    ViewData["Title"] = "My Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">My Products</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add New Product</a>
    </p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You have no products yet.</div>
    }
    else
    {
        <div class="row g-4 modern-products">
            @foreach (var product in Model)
            {
                <div class="col-6 col-sm-6 col-md-4 col-lg-3">
                    <div class="product-card h-100 shadow-sm">
                        <div class="product-media">
                            <img src="@product.ImageUrl" class="product-img" alt="@product.Name" />
                            <div class="product-overlay">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="overlay-btn" title="Edit"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="overlay-btn ms-1" title="Delete"><i class="fas fa-trash"></i></a>
                            </div>
                        </div>
                        <div class="product-body p-3 d-flex flex-column">
                            <h6 class="product-title mb-2">@product.Name</h6>
                            <div class="product-price mb-3">@product.Price.ToString("C")</div>
                            <div class="mt-auto d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit me-1"></i>Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger"><i class="fas fa-trash me-1"></i>Delete</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
