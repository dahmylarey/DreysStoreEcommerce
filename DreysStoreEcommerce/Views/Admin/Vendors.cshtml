@model IEnumerable<DreysStoreEcommerce.Models.Vendor>
@{
    ViewData["Title"] = "Vendors";
}
<h2>Vendors</h2>
<a class="btn btn-primary mb-3" asp-action="CreateVendor">+ Create Vendor</a>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Active</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var vendor in Model)
        {
            <tr>
                <td>@vendor.Name</td>
                <td>@vendor.Email</td>
                <td>@vendor.Phone</td>
                <td>@vendor.IsActive</td>
                <td>
                    <a asp-action="EditVendor" asp-route-id="@vendor.Id" class="btn btn-sm btn-info">Edit</a>
                    <a asp-action="DeleteVendor" asp-route-id="@vendor.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
