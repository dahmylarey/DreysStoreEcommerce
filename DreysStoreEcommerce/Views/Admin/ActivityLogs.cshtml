@model IEnumerable<DreysStoreEcommerce.Models.ActivityLog>

@{
    ViewData["Title"] = "Activity Logs";
}

<h2>Activity Logs</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Action</th>
            <th>Description</th>
            <th>Performed By</th>
            <th>Timestamp</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Action</td>
                <td>@log.Description</td>
                <td>@log.PerformedByUser?.Email</td>
                <td>@log.Timestamp.ToLocalTime()</td>
            </tr>
        }
    </tbody>
</table>
