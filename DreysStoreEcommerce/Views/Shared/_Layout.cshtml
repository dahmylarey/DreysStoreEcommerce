@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject DreysStoreEcommerce.Data.ApplicationDbContext _context
@{
    Layout = null;
    var user = UserManager.GetUserAsync(User).Result;
    var userRoles = user != null ? UserManager.GetRolesAsync(user).Result : new List<string>();
    bool isAdmin = userRoles.Contains("Admin");
    bool isVendor = userRoles.Contains("Vendor");
    var notifications = _context.Notifications.OrderByDescending(n => n.CreatedAt).Take(5).ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Drey E-Commerce Store</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.1.3/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css?family=Poppins:400,700&display=swap" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/responsive.css" rel="stylesheet" asp-append-version="true" />

    <style>
        /* Open dropdown on hover */
        .navbar-nav .dropdown:hover > .dropdown-menu {
            display: block;
        }

        /* Optional: prevent click from closing immediately */
        .navbar-nav .dropdown-toggle:active {
            pointer-events: none;
        }

        /* Reduce spacing between navbar items */
        .navbar-nav {
            gap: 0.18rem; /* small gap when using flexbox */
            align-items: center;
        }

        .navbar-nav .nav-item {
            margin: 0 0.125rem;
            white-space: nowrap; /* keep single-item labels from wrapping */
        }

        .navbar-nav .nav-link {
            padding: 0.25rem 0.5rem; /* smaller clickable area to tighten spacing */
            font-size: 0.95rem;
        }

        /* Ensure buttons styled as links don't enlarge items */
        .navbar-nav .btn-link.nav-link,
        .navbar-nav .nav-link.btn {
            padding: 0;
            border: 0;
            background: none;
        }

        /* Keep notification badge aligned */
        .position-relative .badge {
            transform: translate(50%, -25%);
        }
    </style>
</head>
<body>
    <div class="hero_area">
        <!-- header section -->
        <header class="header_section">
            <div class="container">

                @{
                    var userId = user?.Id;
                    var unreadCount = _context.Notifications.Count(n => n.ApplicationUserId == userId && !n.IsRead);
                    var recentNotes = _context.Notifications
                    .Where(n => n.ApplicationUserId == userId)
                    .OrderByDescending(n => n.CreatedAt)
                    .Take(5)
                    .ToList();
                }


                <nav class="navbar navbar-expand-lg custom_nav-container pt-3">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="Logo" /><span>DreyStore</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                            data-bs-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent" aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Products</a></li>
                           @*  <li class="nav-item"><a class="nav-link" asp-controller="Search" asp-action="Index">Shop</a></li> *@
                            <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Cart</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Order" asp-action="Index">Orders</a></li>

                            @* notification *@
                            @if (notifications.Any())
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle position-relative" href="@Url.Action("Notification","Admin")"  id="notificationsMenu" role="button" as>
                                        <i class="fas fa-bell"></i>
                                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                            @notifications.Count
                                            <span class="visually-hidden">unread notifications</span>
                                        </span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationBell">
                                        @foreach (var note in recentNotes)
                                        {
                                            <li>
                                                <a class="dropdown-item @(note.IsRead ? "" : "fw-bold")">
                                                    @note.Message<br />
                                                    <small class="text-muted">@note.CreatedAt.ToLocalTime().ToString("g")</small>
                                                </a>
                                            </li>
                                        }
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item text-center" asp-controller="YourController" asp-action="Notifications">View All</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="#"><i class="fas fa-bell"></i> No Notifications</a>
                                </li>
                            }

                            @* Admin menu *@
                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminMenu" role="button">Admin</a>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index">Dashboard</a>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Vendors">Manage Vendors</a>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Users">Manage Users</a>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Orders">Manage Orders</a>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Products">Manage Products</a>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="ActivityLogs">Activity Logs</a>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Notifications">Notifications</a>
                                    </div>
                                </li>
                            }
                            @if (isVendor)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="vendorMenu" role="button">Vendor</a>
                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" asp-controller="Vendor" asp-action="Dashboard">Dashboard</a>
                                        <a class="dropdown-item" asp-controller="Vendor" asp-action="MyProducts">My Products</a>
                                        <a class="dropdown-item" asp-controller="Order" asp-action="Index">My Orders</a>
                                    </div>
                                </li>
                            }

                            @if (SignInManager.IsSignedIn(User))
                            {
                                @* <li class="nav-item">
                                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">Hello, @UserManager.GetUserName(User)</a>
                                </li> *@
                                <li class="nav-item">
                                    <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" method="post">
                                        <button type="submit" class="btn btn-link nav-link p-0">Logout</button>
                                    </form>
                                </li>
                                @* <li class="nav-item">
                                    <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">My Profile</a>
                                </li> *@
                            }
                            else
                            {
                                <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                                <li class="nav-item"><a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                            }
                        </ul>
                    </div>
                </nav>
            </div>
        </header>
        <!-- end header section -->
        <div id="Notification" class="alert alert-info alert-dismissible fade show" style="display:none;" role="alert">
            <span id="notificationMessage"></span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <div class="container py-5 text-center">
            @RenderBody()
        </div>

        <section class="container-fluid footer_section">
            <p>&copy; @DateTime.Now.Year All Rights Reserved by <a href="#">DreysStore</a></p>
        </section>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/script.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initMap" async defer></script>
    <!-- Add SignalR script -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", (message, createdAt) => {
            // Show toast
            showToast(`${message} (${new Date(createdAt).toLocaleString()})`);

            // Increase counter
            const countElem = document.getElementById("notificationCount");
            if (countElem) {
                let count = parseInt(countElem.innerText) || 0;
                countElem.innerText = count + 1;
            }

            // Optionally: add to dropdown dynamically
        });

        connection.start().catch(err => console.error(err));
    </script>
    <script>
        function initMap() {
            var map = document.getElementById('map');
            if (map) {
                var gMap = new google.maps.Map(map, {
                    zoom: 11,
                    center: { lat: 40.645037, lng: -73.880224 }
                });
                var image = '/images/maps-and-flags.png';
                new google.maps.Marker({
                    position: { lat: 40.645037, lng: -73.880224 },
                    map: gMap,
                    icon: image
                });
            }
        }
    </script>
    <partial name="_ValidationScriptsPartial" />
    @RenderSection("Scripts", required: false)
</body>
</html>
