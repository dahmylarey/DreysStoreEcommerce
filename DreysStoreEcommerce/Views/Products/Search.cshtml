@model IEnumerable<DreysStoreEcommerce.Models.Product>
@{
    var categories = (List<DreysStoreEcommerce.Models.Category>)ViewBag.Categories;
}
<br />

<div class="container py-5">
    <h2>Search & Filter</h2>

    <form method="get" class="row mb-3">
        <div class="col">
            <input type="text" name="q" placeholder="Search..." class="form-control" />
        </div>
        <div class="col">
            <select name="categoryId" class="form-control">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
        <div class="col">
            <input type="number" step="0.01" name="minPrice" placeholder="Min price" class="form-control" />
        </div>
        <div class="col">
            <input type="number" step="0.01" name="maxPrice" placeholder="Max price" class="form-control" />
        </div>
        <div class="col">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-md-3 mb-3">
                <div class="card">
                    <img src="@p.ImageUrl" class="card-img-top" />
                    <div class="card-body">
                        <h5>@p.Name</h5>
                        <p>@p.Price.ToString("C")</p>
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
    @* @await Html.PartialAsync("_ManageNav") *@
</div>
