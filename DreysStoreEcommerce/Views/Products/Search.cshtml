@model IEnumerable<DreysStoreEcommerce.Models.Product>
@{
    var categories = (List<DreysStoreEcommerce.Models.Category>)ViewBag.Categories;
}
<br />

<div class="container py-5">
    <h2>Search & Filter</h2>

    <form method="get" class="row mb-3">
        <div class="col">
            <input type="text" name="q" placeholder="Search..." class="form-control" />
        </div>
        <div class="col">
            <select name="categoryId" class="form-control">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
        <div class="col">
            <input type="number" step="0.01" name="minPrice" placeholder="Min price" class="form-control" />
        </div>
        <div class="col">
            <input type="number" step="0.01" name="maxPrice" placeholder="Max price" class="form-control" />
        </div>
        <div class="col">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </form>

    <div class="row g-4 modern-products">
        @foreach (var p in Model)
        {
            <div class="col-6 col-sm-6 col-md-4 col-lg-3">
                <div class="product-card h-100 shadow-sm">
                    <div class="product-media">
                        <img src="@p.ImageUrl" class="product-img" />
                        <div class="product-overlay">
                            <a asp-action="Details" asp-route-id="@p.Id" class="overlay-btn"><i class="fas fa-info"></i></a>
                        </div>
                    </div>
                    <div class="product-body p-3 d-flex flex-column">
                        <h6 class="product-title mb-2">@p.Name</h6>
                        <div class="product-price mb-3">@p.Price.ToString("C")</div>
                        <div class="mt-auto d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye me-1"></i>View</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @* @await Html.PartialAsync("_ManageNav") *@
</div>
