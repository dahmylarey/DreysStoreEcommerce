@model IEnumerable<DreysStoreEcommerce.Models.Product>
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Products";
    Layout = "_layout";
}
<div class="container py-5">
    <h2 class="mb-3 align-content-center">All Products</h2><br />

    <a class="btn btn-primary mb-3 align-content-center" asp-action="Create">Add New Product</a>

    <div class="row rounded">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card h-100">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Price.ToString("C")</p><!-- "C" = currency format -->

                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary mb-1">Details</a>

                            <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-sm btn-success mb-1">Add to Cart</button>
                            </form>

                            @{
                                var user = UserManager.GetUserAsync(User).Result;
                                var roles = user != null ? UserManager.GetRolesAsync(user).Result : new List<string>();
                                var isAdminOrVendor = roles.Contains("Admin") || roles.Contains("Vendor");
                            }

                            @if (isAdminOrVendor)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning mb-1">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger mb-1">Delete</a>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>
